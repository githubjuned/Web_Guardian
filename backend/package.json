{
  "name": "@webguardian/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WebGuardian AI backend — Express API, Playwright agent, detectors and Gemini reasoning",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.ts",
    "start": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@google/genai": "^1.20.0",
    "@webguardian/shared": "*",
    "axe-core": "^4.10.3",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "lighthouse": "^12.8.2",
    "nanoid": "^5.1.6",
    "playwright": "1.56.1",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
