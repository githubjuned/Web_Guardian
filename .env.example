# ---------------------------------------------------------------
# WebGuardian AI — environment configuration
# Copy to backend/.env (local) or set in your cloud provider.
# NEVER commit real secrets.
# ---------------------------------------------------------------

# Google Gemini (backend only — never exposed to the browser)
GEMINI_API_KEY=
# Optional: override the Gemini model
GEMINI_MODEL=gemini-3.8-flash

# SQLite database file (the MVP uses Node's built-in SQLite)
DATABASE_URL=file:./data/webguardian.db

# Backend port
PORT=8080

# Public URL of the frontend (used for CORS). Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173

# Public URL of this backend. Used to build demo-site sandbox URLs.
PUBLIC_BASE_URL=http://localhost:8080

# Optional tuning
MAX_CONCURRENT_AUDITS=2
LIGHTHOUSE_ENABLED=true
# Allow auditing private/intranet addresses (keep false in production)
ALLOW_PRIVATE_URLS=false
# Optional: comma-separated Gemini models to try if the main one is busy or retired.
# Leave empty to auto-discover available Flash models for your key.
GEMINI_FALLBACK_MODELS=
